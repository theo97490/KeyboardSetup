" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc

" Good stuff : https://www.cyberwizard.io/posts/the-ultimate-ideavim-setup/

set relativenumber
set number

"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.an-i-make-vim-paste-from-and-copy-to-the-systems-clipboard
set scrolloff=5
set smartcase

" Do incremental searching.
set surround
set incsearch
set hlsearch
set nerdtree
set which-key

" Don't use Ex mode, use Q for formatting.
map Q gq

let mapleader = " "

" Yank 
set clipboard+=unnamed

" Move tabs
nnoremap <TAB> :tabnext<CR>
nnoremap <S-TAB> :tabprev<CR>\

" Move between panes
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <A-h> <C-w>h
nnoremap <A-l> <C-w>l
nnoremap <A-k> <C-w>k
nnoremap <A-j> <C-w>j

" Actions
set notimeout

"" Leader
map <Leader><Leader> <Action>(GotoFile)
map <leader>c <action>(CommentByLineComment)
map <leader>lf <action>(ReformatCode)
map <leader>a <action>(ShowIntentionActions)
map <leader>x <action>(CloseContent)
map <leader>wp <action>(PinActiveTab)
map <leader>bc <action>(CloseAllEditorsButActive)

"" LSP
nmap gd <Action>(GotoDeclaration)
nmap gS <Action>(GotoSymbol)
nmap gs <Action>(FileStructurePopup)
nmap gy <Action>(GotoTypeDeclaration)
nmap gi <Action>(GotoImplementation)
nmap gu <Action>(ShowUsages)
nmap gt <Action>(GotoTest)
nmap gf <Action>(Back)
nmap gb <Action>(Forward)

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins
" Highlight copied text
Plug 'machakann/vim-highlightedyank'
" Commentary plugin
Plug 'tpope/vim-commentary'


"" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
"" Map \r to the Reformat Code action
"map \r <Action>(ReformatCode)

"" Map <leader>d to start debug
"map <leader>d <Action>(Debug)

"" Map \b to toggle the breakpoint on the current line
"map \b <Action>(ToggleLineBreakpoint)
